# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
out/
dist/
build/
.turbo/

# Env
.env
.env.local
.env.*.local
!.env.example

# Captured real-credential dotfiles from prod-verify / rollback work — never commit.
/.env.orig
/.env.prod-verify

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp

# Test coverage
coverage/
.nyc_output/
.playwright-cli/

# TypeScript
*.tsbuildinfo

# Drizzle
drizzle/.snapshot/

# Legacy-migration data dumps — large schema/mapping JSON reproducible from the
# legacy MSSQL DB; kept local, not committed. (The .md docs beside them ARE kept.)
docs/migration/*.json

# Local storage
.r2-local/
uploads/
.local/
private/

# Misc
.cache/
*.local

# Local ops helpers that embed cluster creds — never commit.
packages/db/src/scripts/dokploy-*.ts

# Playwright E2E artifacts (screenshots, traces, HTML/JSON reports) and any
# locally captured auth state. Regenerated on every run; never committed.
test-results/
playwright-report/
blob-report/
playwright/.cache/
apps/web/e2e/.auth/
apps/web/e2e/**-results.json

# Private legacy-migration ETL — lives on the migration Mac only and contains
# company-specific mappers. It links local packages but is excluded from the
# public pnpm workspace and lockfile; install and run it independently.
packages/etl/

# Local-only operational evidence (source archives, build output, manifests).
# ~1.5G of tarballs + byte-exact raw snapshots under docs/evidence; kept on
# this machine, never committed. Knip honors .gitignore, so it also keeps the
# dead-code scan out — an explicit knip ignore would trip "Remove from
# ignore" on a fresh clone where the directory does not exist.
/docs/evidence/

# Local debugging scratch: MCP console logs, docker build secrets scratch, and
# opencode backup configs. Kept on this machine, never committed. (The large
# docs/evidence archive dir and repo-root .tmp-* scratch dirs are intentionally
# NOT gitignored: knip configs + contract tests rely on scanning them, and
# they are simply never staged. Stage selectively; never `git add -A` blindly.)
.playwright-mcp/
.docker/
.opencode/*.before-*

# Auto-generated by Next — regenerated on every build and marked "should not
# be edited", so never format/check it.
next-env.d.ts
**/next-env.d.ts

# Build output / caches (also gitignored, but be explicit so local runs skip them).
**/.next/
**/dist/
**/.turbo/
**/coverage/
pnpm-lock.yaml

# Drizzle-generated migration journal + snapshots — regenerated by drizzle-kit
# (`generate`), never hand-edited, and not emitted in Prettier's JSON style.
packages/db/drizzle/meta/

# Local-only/private migration material kept out of the public repo.
.local/
private/
docs/migration/*.json
packages/db/src/scripts/dokploy-*.ts
packages/etl/

# Playwright E2E artifacts are machine-generated and not hand-formatted.
**/test-results/
**/playwright-report/
apps/web/e2e/**-results.json

# Raw OCI evidence blobs. These are byte-exact extracts from image manifests,
# configs, attestations and provenance. Reformatting them would change their
# SHA-256 and break the digest-to-blob correspondence that makes them evidence.
# Only the human-written README is formatted.
docs/evidence/*/**/*.json
docs/evidence/*/**/Dockerfile
docs/evidence/*/SHA256SUMS
docs/evidence/*/**/*.log

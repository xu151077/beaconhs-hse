{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "APP_VERSION",
    "DATABASE_URL",
    "SUPERADMIN_DATABASE_URL",
    "MIGRATION_DATABASE_URL",
    "AUDIT_DATABASE_URL",
    "DATABASE_OWNER_ROLE",
    "DATABASE_BACKUP_ROLE",
    "DATABASE_POOL_MAX",
    "SUPERADMIN_POOL_MAX",
    "REDIS_URL",
    "R2_ENDPOINT",
    "R2_INTERNAL_ENDPOINT",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET",
    "R2_PUBLIC_URL",
    "R2_PRIVATE_BUCKET_CONFIRMED",
    "ATTACHMENT_CAPABILITY_SECRET",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_FROM",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_FROM",
    "VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY",
    "VAPID_SUBJECT",
    "SENTRY_DSN",
    "SENTRY_ENVIRONMENT",
    "NEXT_PUBLIC_SENTRY_DSN",
    "APP_URL",
    "PUBLIC_APP_URL",
    "NEXT_PUBLIC_APP_URL",
    "INTERNAL_WEB_URL",
    "DEV_ALLOWED_ORIGINS",
    "DEPLOYMENT_VERSION",
    "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY",
    "COLLABORA_URL",
    "COLLABORA_WOPI_URL",
    "SOFFICE_PATH",
    "PUPPETEER_EXECUTABLE_PATH",
    "NANGO_HOST",
    "NANGO_SECRET_KEY",
    "SYNC_DATABASE_HOST_ALLOWLIST",
    "BEACONHS_WORKER_SHUTDOWN_GRACE_MS",
    "BEACONHS_ISOLATED_ALERTS_ENABLED",
    "BEACONHS_BT_FREEZE_DRIVER"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}

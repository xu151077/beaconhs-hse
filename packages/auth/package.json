{
  "name": "@beaconhs/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./invites": "./src/invites.ts"
  },
  "scripts": {
    "bootstrap:admin": "tsx --env-file=../../.env src/bootstrap-admin.cli.ts",
    "bootstrap:email-provider": "tsx --env-file=../../.env src/bootstrap-email-provider.cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@beaconhs/compliance": "workspace:*",
    "@beaconhs/crypto": "workspace:*",
    "@beaconhs/db": "workspace:*",
    "@beaconhs/emails": "workspace:*",
    "@beaconhs/jobs": "workspace:*",
    "@beaconhs/sync": "workspace:*",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}

{
  "name": "@beaconhs/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./canonical-templates": "./src/canonical-templates.ts",
    "./client": "./src/client.ts",
    "./journal-class": "./src/journal-class.ts",
    "./rls": "./src/rls.ts",
    "./schema": "./src/schema/index.ts",
    "./seed/lift-plan-template": "./src/seed/lift-plan-template.ts",
    "./seed/pdf-templates": "./src/seed/pdf-templates.ts",
    "./seed/report-definitions": "./src/seed/report-definitions.ts",
    "./tenant-provisioning": "./src/tenant-provisioning.ts",
    "./work-permit": "./src/work-permit.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "provision:first-tenant": "tsx --env-file=../../.env src/scripts/provision-first-tenant.cli.ts",
    "push": "drizzle-kit push",
    "push:ci": "drizzle-kit push --force",
    "studio": "drizzle-kit studio",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "backfill:reference-catalogues": "tsx src/scripts/backfill-reference-catalogues.cli.ts",
    "emit:cutover-verification": "tsx src/scripts/emit-cutover-verification.cli.ts",
    "check:migration-drift": "tsx src/scripts/check-migration-drift.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@beaconhs/forms-core": "workspace:*",
    "@beaconhs/i18n": "workspace:*",
    "@braedonsaunders/appkit-reports": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
